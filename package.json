{
  "name": "mant",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --no-env-file scripts/dev.ts",
    "start": "bun --no-env-file server/index.ts",
    "typecheck": "tsc -b",
    "test": "bun test",
    "test:live": "bun --no-env-file scripts/live-smoke.ts",
    "build": "tsc -b && bun --bun vite build",
    "lint": "oxlint",
    "capture:build": "bun --no-env-file scripts/build-capture.ts",
    "diagnostics": "bun --no-env-file scripts/diagnostics.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "description": "A local, multilingual assistant that helps you prepare before a call, then follows the live transcript, tracks your objectives, and suggests replies during the conversation automatically.",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  }
}
